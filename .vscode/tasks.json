{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "cmake",
      "label": "CMake: build",
      "detail": "Build the current target",
      "command": "build",
      "targets": [
        "${command:cmake.buildTargetName}"
      ],
      "preset": "${command:cmake.activeBuildPresetName}",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "type": "cmake",
      "label": "CMake: build headless",
      "detail": "Build the headless target",
      "command": "build",
      "targets": [
        "prette-headless"
      ],
      "preset": "${command:cmake.activeBuildPresetName}",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": false
      }
    },
    {
      "type": "cmake",
      "label": "CMake: generate C/C++ sources for flatbuffers",
      "detail": "Run FlatC for the flatbuffer resources",
      "command": "build",
      "targets": [
        "prt-flatbuffers"
      ],
      "preset": "${command:cmake.activeBuildPresetName}",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": false
      }
    },
    {
      "type": "cmake",
      "label": "CMake: build sandbox",
      "detail": "Build the sandbox target",
      "command": "build",
      "targets": [
        "prette-sandbox"
      ],
      "preset": "${command:cmake.activeBuildPresetName}",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": false
      }
    },
    {
      "type": "cmake",
      "label": "CMake: build all shaders",
      "detail": "Build the current target",
      "command": "build",
      "targets": [
        "shaders"
      ],
      "preset": "${command:cmake.activeBuildPresetName}",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "type": "shell",
      "label": "clean build/",
      "command": "find . '!' -name '.gitkeep' -delete",
      "options": {
        "cwd": "${workspaceFolder}/build/"
      },
      "problemMatcher": [],
      "detail": "Clean the build/ directory"
    },
    {
      "type": "shell",
      "label": "open docs",
      "command": "open index.html",
      "options": {
        "cwd": "${workspaceFolder}/docs/html"
      },
      "problemMatcher": [],
      "detail": "Open Doxygen docs in browser"
    },
    {
      "type": "shell",
      "label": "open Sources/ coverage",
      "command": "open index.html",
      "options": {
        "cwd": "${workspaceFolder}/build/Sources/html"
      },
      "problemMatcher": [],
      "detail": "open Sources/ coverage in browser"
    },
    {
      "type": "shell",
      "label": "open Tests/ coverage",
      "command": "open index.html",
      "options": {
        "cwd": "${workspaceFolder}/build/Tests/html"
      },
      "problemMatcher": [],
      "detail": "open Tests/ coverage in browser"
    }
  ]
}