#ifndef PRT_GFX_H
#define PRT_GFX_H

#include <glog/logging.h>
#include <units.h>

#include <iostream>
#include <semver/semver.hpp>

#include "prette/common.h"
#ifdef PRT_VK

#include "prette/gfx_vk.h"

#elif PRT_GL

#include "prette/gfx_gl.h"

#else
#error "Unsupported Graphics Library"
#endif

#ifdef PRT_GLFW

#ifdef PRT_VK
#define GLFW_INCLUDE_VULKAN
#else
#define GLFW_INCLUDE_NONE
#endif  // PRT_VK

#include <GLFW/glfw3.h>
// clang-format off
#define PRT_GLFW_CTX_VERSION_MAJOR @PROJECT_GLFW_CONTEXT_VERSION_MAJOR@
#define PRT_GLFW_CTX_VERSION_MINOR @PROJECT_GLFW_CONTEXT_VERSION_MINOR@
// clang-format on

#endif  // PRT_GLFW

#include "prette/glm.h"

#ifndef PI
#ifdef M_PI
#define PI M_PI
#else
#define PI 3.141592654
#endif
#endif  // PI

namespace prt::gfx {
using semver::version;

void Init();

static inline auto GetGlfwVersion() -> version {
  return version(GLFW_VERSION_MAJOR, GLFW_VERSION_MINOR, GLFW_VERSION_REVISION);
}
}  // namespace prt::gfx

#endif  // PRT_GFX_H