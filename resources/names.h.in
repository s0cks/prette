}  // namespace female

namespace male {
// clang-format off
  static constexpr const auto kTotalNumberOfBytes = @PRT_FORENAMES_MALE_NUM_BYTES@;
  static constexpr const uint8_t kBytes[kTotalNumberOfBytes] = {
    @PRT_FORENAMES_MALE_BYTES@
  };
// clang-format on
}  // namespace male
}  // namespace forenames

namespace surnames {
