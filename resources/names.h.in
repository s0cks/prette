  static constexpr const auto kTotalNumberOfBytes = @PRT_SURNAMES_NUM_BYTES@;
  static constexpr const uint8_t kBytes[kTotalNumberOfBytes] = {
    @PRT_SURNAMES_BYTES@
  };
// clang-format on
}  // namespace surnames
}  // namespace prt

#endif  // PRT_NAMES_H
